build/

# Flutter metadata (should not be tracked)
.metadata

# OS files
Thumbs.db

# Android — the gradle files, manifest and MainActivity are tracked; only
# the generated and machine-specific parts are ignored. The whole folder
# used to be ignored, which left fresh clones with no Android entry point.
android/.gradle/
android/.kotlin/
android/app/.cxx/
android/build/
android/app/build/
android/local.properties
android/key.properties
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Signing material — never commit these
*.jks
*.keystore

# iOS
ios/

# Other generated platform folders
linux/
macos/
windows/
web/

# Symbolication related
app.*.symbols

# Executable distributions
*.apk
*.aab
*.ex_
*.ipa


# CocoaPods
macos/Pods/

