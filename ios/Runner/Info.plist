<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Togetherirl</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>togetherirl</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>TogetherIRL uses the camera to photograph receipts for bill splitting and to capture photos for a hangout's shared album.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TogetherIRL needs your photo library so you can add photos to a hangout's shared album and scan a saved receipt.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TogetherIRL saves photos from a shared album back to your library.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TableTalk uses your microphone so your group can hear you during a hangout.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TogetherIRL uses your location to suggest hangout spots near your group.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>TableTalk uses Bluetooth so you can talk through wireless headphones.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>TogetherIRL connects to a development server running on your computer during testing.</string>
	<!-- Permits plain HTTP to hosts on the local network only. Internet
	     traffic is still held to App Transport Security, so this is not
	     the blanket NSAllowsArbitraryLoads exemption. Needed while the
	     backend runs on a laptop rather than a deployed host. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
